{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "migrations/**/*.ts", "test/**/*.ts", "knexfile.ts", "hardhat.config.ts"],
  "exclude": ["dist", "node_modules"]
}
