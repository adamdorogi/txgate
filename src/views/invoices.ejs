<%- include("partials/head") %>
<%- include("partials/nav") %>
<main class="container py-4">
  <h1 class="h3 mb-3">Invoices</h1>
  <form method="get" action="/admin/invoices" class="row g-2 align-items-end mb-3">
    <div class="col-sm-3">
      <label class="form-label" for="filter-chain">Chain</label>
      <select class="form-select form-select-sm" name="chain" id="filter-chain">
        <option value="">All chains</option>
        <% for (const chain of chains) { %>
          <option value="<%= chain %>" <%= filter.chain === chain ? "selected" : "" %>><%= chain %></option>
        <% } %>
      </select>
    </div>
    <div class="col-sm-3">
      <label class="form-label" for="filter-asset">Asset</label>
      <select class="form-select form-select-sm" name="assetId" id="filter-asset">
        <option value="">All assets</option>
        <% for (const [id, symbols] of filterAssets) { %>
          <option value="<%= id %>" <%= filter.assetId === id ? "selected" : "" %>>
            <%= [...symbols].join(" / ") %>
          </option>
        <% } %>
      </select>
    </div>
    <div class="col-sm-3">
      <label class="form-label" for="filter-status">Status</label>
      <select class="form-select form-select-sm" name="status" id="filter-status">
        <option value="">All statuses</option>
        <% for (const status of invoiceStatuses) { %>
          <option value="<%= status %>" <%= filter.status === status ? "selected" : "" %>><%= status %></option>
        <% } %>
      </select>
    </div>
    <div class="col-sm-auto"><button class="btn btn-sm btn-outline-secondary" type="submit">Filter</button></div>
  </form>
  <div class="table-responsive">
    <table class="table table-sm table-striped table-bordered align-middle bg-white">
      <thead><tr><th scope="col">Invoice</th><th scope="col">Chain</th><th scope="col">Amount</th><th scope="col">Paid</th><th scope="col">Status</th><th scope="col">Depth</th><th scope="col">Created</th></tr></thead>
      <tbody>
        <% for (const invoice of invoices) { %>
          <tr>
            <td><a class="font-monospace" href="/admin/invoices/<%= invoice.id %>"><%= invoice.id %></a></td>
            <td><%= invoice.chain %></td>
            <td class="status-cell"><%= formatAmount(invoice.amount, invoice.decimals) %> <%= invoice.assetSymbol %></td>
            <td><%= formatAmount(invoice.paid, invoice.decimals) %></td>
            <td><span class="badge <%= badgeClass(invoice.status) %>"><%= invoice.status %></span></td>
            <td class="status-cell"><%= invoice.confirmations %> / <%= invoice.targetConfirmations %> blocks</td>
            <td class="status-cell"><%= formatTime(invoice.createdAt) %></td>
          </tr>
        <% } %>
        <% if (!invoices.length) { %><tr><td colspan="7" class="text-muted">No invoices found.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <section class="card mt-3">
    <div class="card-body">
      <h2 class="h5">Create test invoice</h2>
      <form method="post" action="/admin/invoices" class="row g-2 align-items-end">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <div class="col-sm-3">
          <label class="form-label" for="asset">Asset</label>
          <select class="form-select form-select-sm" id="asset" name="asset" required>
            <% for (const asset of assets) { %>
              <option value="<%= assetKey(asset.chain, asset.id) %>"><%= asset.symbol %> (<%= asset.chain %>)</option>
            <% } %>
          </select>
        </div>
        <div class="col-sm-2">
          <label class="form-label" for="amount">Amount</label>
          <input class="form-control form-control-sm" id="amount" name="amount" inputmode="decimal" placeholder="125.00" required>
        </div>
        <div class="col-sm-2">
          <label class="form-label" for="ttl">TTL (seconds)</label>
          <input class="form-control form-control-sm" id="ttl" name="ttlSeconds" type="number" min="1" step="1">
        </div>
        <div class="col-sm-3">
          <label class="form-label" for="sku">Reservation SKU</label>
          <input class="form-control form-control-sm" id="sku" name="sku" maxlength="128">
        </div>
        <div class="col-sm-auto"><button class="btn btn-sm btn-primary" type="submit">Create</button></div>
      </form>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
