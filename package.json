{
  "name": "txgate",
  "version": "0.3.2",
  "private": true,
  "description": "Watch-only payment daemon",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "test": "ts-mocha --timeout 10000 \"test/*.test.ts\"",
    "dev": "nodemon --watch src --ext ts,ejs --exec ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "sim:payment": "ts-node scripts/sim-chain.ts",
    "test:contracts": "hardhat test",
    "dev:evm": "hardhat node --hostname 0.0.0.0",
    "deploy:factory": "hardhat run scripts/deploy-factory.ts"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "ts-node": "10.5.0",
    "@types/node": "22.15.3",
    "mocha": "9.2.1",
    "chai": "4.3.6",
    "ts-mocha": "9.0.0",
    "@types/mocha": "9.1.0",
    "@types/chai": "4.3.0",
    "nodemon": "2.0.15",
    "@types/express": "4.17.21",
    "@types/express-session": "1.17.4",
    "@types/connect-pg-simple": "7.0.0",
    "@types/qrcode": "1.4.2",
    "hardhat": "2.26.3",
    "solc": "0.8.24"
  },
  "dependencies": {
    "knex": "1.0.3",
    "pg": "8.7.3",
    "@emurgo/cardano-serialization-lib-nodejs": "11.0.5",
    "blakejs": "1.2.1",
    "bech32": "2.0.0",
    "joi": "17.6.0",
    "pino": "7.8.0",
    "axios": "1.13.6",
    "express": "4.22.1",
    "ejs": "3.1.10",
    "express-session": "1.17.2",
    "connect-pg-simple": "7.0.0",
    "helmet": "5.0.2",
    "bootstrap": "5.1.3",
    "qrcode": "1.5.0",
    "viem": "2.9.18"
  },
  "engines": {
    "node": ">=22"
  }
}
