{
  "name": "txgate",
  "version": "0.1.0",
  "private": true,
  "description": "Watch-only payment daemon",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "test": "ts-mocha --timeout 10000 \"test/*.test.ts\"",
    "dev": "nodemon --watch src --ext ts,ejs --exec ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "sim:payment": "ts-node scripts/sim-chain.ts"
  },
  "devDependencies": {
    "typescript": "~4.5.5",
    "ts-node": "10.5.0",
    "@types/node": "16.11.26",
    "mocha": "9.2.1",
    "chai": "4.3.6",
    "ts-mocha": "9.0.0",
    "@types/mocha": "9.1.0",
    "@types/chai": "4.3.0",
    "nodemon": "2.0.15"
  },
  "dependencies": {
    "knex": "1.0.3",
    "pg": "8.7.3",
    "@emurgo/cardano-serialization-lib-nodejs": "10.0.4",
    "blakejs": "1.2.1",
    "bech32": "2.0.0",
    "joi": "17.6.0",
    "pino": "7.8.0"
  }
}
